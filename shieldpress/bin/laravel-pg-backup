#!/bin/bash
# Shared runner for manual backups and existing PostgreSQL Manager cron jobs.
set -euo pipefail
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
BASE_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
source "$BASE_DIR/core/paths.sh"
umask 077
mkdir -p "$LOG_DIR"
# Manual callers capture stdout to obtain the backup path. Keep their terminal
# on fd 3 before stderr is redirected to the persistent diagnostic log.
exec 3>&2
INTERACTIVE_PROGRESS=0
if [ "${3:-}" = "--progress" ] && [ -t 3 ]; then
    INTERACTIVE_PROGRESS=1
fi
# Cron historically discards stderr. Keep diagnostics independently of its redirect.
exec 2>>"$LOG_DIR/postgresql-backup.log"
DB_NAME="${1:-}"
[[ "$DB_NAME" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || { echo 'Invalid or missing database name'; exit 1; }
KEEP="${2:-}"
if [ -z "$KEEP" ] && [ -f "$BASE_DIR/config/pg-backup-retention" ]; then
    KEEP=$(cat "$BASE_DIR/config/pg-backup-retention")
fi
KEEP="${KEEP:-7}"
[[ "$KEEP" =~ ^[0-9]+$ ]] && (( 10#$KEEP > 0 )) || { echo 'Invalid retention'; exit 1; }
KEEP=$((10#$KEEP))
DB_META="$DATA_DIR_LARAVEL_DB/${DB_NAME}.env"
# Metadata is optional for physical replicas: pg_dump runs as postgres and can
# back up any database visible in pg_database. Tracked databases still retain
# their normal metadata-backed behavior in PostgreSQL Manager.
BACKUP_DIR="$BACKUP_GLOBAL_DIR/laravel-postgresql/$DB_NAME"
mkdir -p "$BACKUP_DIR"
exec 9>"$BACKUP_DIR/.backup.lock"
flock -n 9 || { echo "Backup already running: $DB_NAME" >&2; exit 1; }
BACKUP_FILE="$BACKUP_DIR/${DB_NAME}_$(date '+%Y%m%d_%H%M%S').sql.gz"
PARTIAL=$(mktemp "$BACKUP_DIR/.partial.XXXXXX")
PROGRESS_PID=""
# Source replacement upgrades existing manual and cron callers automatically.
TIMING_FILE="$BACKUP_DIR/.dump-duration"
DUMP_STARTED=$SECONDS
stop_progress(){
    if [ -n "$PROGRESS_PID" ]; then
        kill "$PROGRESS_PID" 2>/dev/null || true
        wait "$PROGRESS_PID" 2>/dev/null || true
        PROGRESS_PID=""
        printf '\r\033[K' >&3
    fi
}
start_progress(){
    [ "$INTERACTIVE_PROGRESS" -eq 1 ] || return 0
    local label="$1" progress_file="$2"
    local estimate=60 basis="approximate estimate" previous
    if [ -f "$TIMING_FILE" ]; then
        read -r previous < "$TIMING_FILE" || true
        if [[ "$previous" =~ ^[1-9][0-9]{0,6}$ ]]; then
            estimate="$previous"
            basis="previous successful run"
        fi
    fi
    printf '[STAGE] %s: estimated duration ~%ss (%s).\n' "$label" "$estimate" "$basis" >&3
    (
        tick_pid=""
        trap 'kill "$tick_pid" 2>/dev/null || true; wait "$tick_pid" 2>/dev/null || true; exit 0' TERM INT HUP
        local frames='|/-\' index=0 elapsed remaining bytes=0 last=-1 detail
        while :; do
            elapsed=$((SECONDS - DUMP_STARTED))
            remaining=$((estimate - elapsed))
            if [ "$elapsed" -ne "$last" ]; then
                bytes=$(stat -c %s "$progress_file" 2>/dev/null || echo 0)
                last="$elapsed"
            fi
            if [ "$remaining" -gt 0 ]; then
                detail="ETA ~${remaining}s"
            else
                detail="taking longer than estimated; still running"
            fi
            printf '\r\033[K[%s] %s | %s | backup size: %s bytes' \
                "${frames:index%4:1}" "$label" "$detail" "$bytes" >&3
            index=$((index + 1))
            sleep 0.2 &
            tick_pid=$!
            wait "$tick_pid" || exit 0
        done
    ) >/dev/null &
    PROGRESS_PID=$!
}
cleanup(){
    status=$?
    stop_progress
    rm -f "$PARTIAL"
    if [ "$status" -ne 0 ]; then
        echo "$(date -Is) [FAIL] PostgreSQL backup: $DB_NAME (exit $status)" >&2
        [ "$INTERACTIVE_PROGRESS" -eq 1 ] && echo "Backup failed. Details: $LOG_DIR/postgresql-backup.log" >&3
    fi
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
cd /tmp
# A failing pg_dump must never publish a compressed partial SQL file.
start_progress "Backing up PostgreSQL database: $DB_NAME" "$PARTIAL"
runuser -u postgres -- pg_dump --no-owner --no-privileges --dbname="$DB_NAME" | gzip > "$PARTIAL"
stop_progress
[ "$INTERACTIVE_PROGRESS" -eq 1 ] && echo "Dump complete. Verifying backup..." >&3
gzip -t "$PARTIAL"
mv "$PARTIAL" "$BACKUP_FILE"
# Advisory timing must never turn a completed backup into a failure.
if timing_tmp=$(mktemp "$BACKUP_DIR/.timing.XXXXXX"); then
    duration=$((SECONDS - DUMP_STARTED))
    if printf '%s\n' "$((duration > 0 ? duration : 1))" > "$timing_tmp"; then
        mv -f -- "$timing_tmp" "$TIMING_FILE" || rm -f -- "$timing_tmp"
    else
        rm -f -- "$timing_tmp"
    fi
fi
# Delete old completed backups only after a successful dump.
mapfile -t backups < <(find "$BACKUP_DIR" -maxdepth 1 -type f -name "${DB_NAME}_*.sql.gz" -printf '%f\n' | sort -r)
for ((i=KEEP; i<${#backups[@]}; i++)); do
    rm -f -- "$BACKUP_DIR/${backups[i]}"
done
if [ "${4:-}" != "--local-only" ] && [ -f "$BASE_DIR/modules/backup/_backup_helper.sh" ]; then
    DOMAIN="$DB_NAME"
    # Legacy helpers were written without nounset/errexit; isolate their options.
    if [ "$INTERACTIVE_PROGRESS" -eq 1 ]; then
        # stdout is reserved for the backup path. Send rclone's real transfer
        # stats to the terminal while keeping the persistent remote log.
        if (
            set +eu
            source "$BASE_DIR/modules/backup/_backup_helper.sh"
            remote_upload_backup "$BACKUP_FILE" db
        ) 2>&1 | tee -a "$LOG_DIR/remote-backup.log" >&3; then
            :
        else
            echo "Remote upload failed; local backup retained. Details: $LOG_DIR/remote-backup.log" >&3
            echo "Remote upload failed: $DB_NAME" >&2
        fi
    else
        (
            set +eu
            source "$BASE_DIR/modules/backup/_backup_helper.sh"
            remote_upload_backup "$BACKUP_FILE" db
        ) >>"$LOG_DIR/remote-backup.log" 2>&1 || echo "Remote upload failed: $DB_NAME" >&2
    fi
fi
echo "$(date -Is) [OK] PostgreSQL backup: $DB_NAME -> $BACKUP_FILE" >&2
printf '%s\n' "$BACKUP_FILE"
