#!/bin/bash
# ShieldPress FastCGI Cache Purge Helper
# Called via sudo from PHP mu-plugin.
# Only accepts a sanitized domain directory name.

CACHE_BASE="/var/cache/nginx"

DOMAIN_DIR="$1"

# Validate: only allow alphanumeric and underscore (matches CLEAN_DOMAIN format)
if [[ ! "$DOMAIN_DIR" =~ ^[a-zA-Z0-9_]+$ ]]; then
    echo "Invalid domain directory name" >&2
    exit 1
fi

CACHE_DIR="$CACHE_BASE/$DOMAIN_DIR"

# A web account may purge its own cache only. Root timers remain supported.
if [ "$EUID" -ne 0 ]; then
    echo "Root privilege is required" >&2
    exit 1
fi
if [ -n "${SUDO_USER:-}" ] && [ "$SUDO_USER" != root ]; then
    ENV_FILE="/home/domains/$DOMAIN_DIR/config/domain.env"
    [ ! -L "$ENV_FILE" ] && [ -f "$ENV_FILE" ] || exit 1
    SYSTEM_USER=$(sed -n 's/^SYSTEM_USER=//p' "$ENV_FILE")
    [ "$SYSTEM_USER" = "$SUDO_USER" ] || { echo "Cache purge denied for this domain" >&2; exit 1; }
fi

if [ ! -d "$CACHE_DIR" ]; then
    exit 0
fi

find "$CACHE_DIR" -type f -delete 2>/dev/null
exit 0
