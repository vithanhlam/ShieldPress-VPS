#!/bin/bash
# Fixed, root-owned implementation for domain schedules. No generated site code.
set -o pipefail
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
BASE_DIR="${BASE_DIR:-/opt/shieldpress}"
source "$BASE_DIR/core/paths.sh"
source "$BASE_DIR/core/domain-security.sh"

folder="${1:-}" kind="${2:-}" mode="${3:-full}" retention="${4:-1}"
[[ "$folder" =~ ^[A-Za-z0-9_][A-Za-z0-9_-]{0,63}$ ]] || exit 1
[[ "$kind" =~ ^(db|files|full)$ && "$mode" =~ ^(full|incremental)$ ]] || exit 1
[[ "$retention" =~ ^[0-9]+$ ]] && [ "$retention" -ge 1 ] && [ "$retention" -le 60 ] || exit 1
sp_domain_control check "$folder" || exit 1
DOMAIN_PATH="$DOMAINS_ROOT/$folder"
sp_load_domain_env "$DOMAIN_PATH" || exit 1
[ ! -L "$DOMAIN_PATH/public_html" ] && [ -d "$DOMAIN_PATH/public_html" ] || exit 1

source "$BASE_DIR/modules/backup/_backup_helper.sh"
load_domain_info "$DOMAIN_PATH" || exit 1
[ "$BK_ENABLED" != 0 ] || exit 0
umask 077
work=$(mktemp -d "$DOMAIN_PATH/backup/.job.XXXXXXXX") || exit 1
cleanup_job(){
    local result=$?
    rm -rf -- "$work"
    if [ "$result" -ne 0 ]; then
        shieldpress_notify_event backup_fail "Scheduled backup failed" "$DOMAIN ($kind)" || true
    fi
}
trap cleanup_job EXIT
exec 9>"$DOMAIN_PATH/config/.backup-$kind.lock"
flock -n 9 || exit 0
date_tag=$(date +%F_%H-%M-%S)_$$
# A restorable website package must contain a complete source snapshot.
[ "$kind" != full ] || mode=full
case "$kind" in
    db)
        [ "$DB_BACKUP_ENABLED" != 0 ] || exit 0
        target_dir="$DOMAIN_PATH/backup/db"
        filename="${DB_NAME}_$date_tag.sql.gz"
        backup_db_to_file "$work/$filename" || exit 1
        pattern="${DB_NAME}_*.sql.gz"
        ;;
    files)
        target_dir="$DOMAIN_PATH/backup/files"
        filename="files_${mode}_$date_tag.tar.gz"
        if [ "$mode" = incremental ]; then
            archive_source_incremental "$work/$filename" 24
            result=$?
            if [ "$result" -eq 2 ]; then
                ok "No changed source files for $DOMAIN; backup skipped"
                exit 0
            fi
            [ "$result" -eq 0 ] || exit 1
        else
            archive_source_to_file "$work/$filename" || exit 1
        fi
        pattern='files_*.tar.gz'
        ;;
    full)
        target_dir="$DOMAIN_PATH/backup/full"
        filename="full_${mode}_$date_tag.tar.gz"
        if [ -n "$DB_NAME" ] && [ "$DB_CONNECTION" != none ]; then
            backup_db_to_file "$work/db.sql.gz" || exit 1
        else
            printf 'No database configured\n' > "$work/db.skipped"
        fi
        archive_source_to_file "$work/files.tar.gz" || exit 1
        cp -- "$DOMAIN_PATH/config/domain.env" "$work/domain.env" || exit 1
        # Keep the existing restore format: nested files archive and database dump.
        members=(files.tar.gz domain.env)
        if [ -f "$work/db.sql.gz" ]; then members+=(db.sql.gz); else members+=(db.skipped); fi
        tar -czf "$work/$filename" -C "$work" -- "${members[@]}" || exit 1
        pattern='full_*.tar.gz'
        ;;
esac
mkdir -p -- "$target_dir" || exit 1
[ ! -L "$target_dir" ] || exit 1
mv -T -- "$work/$filename" "$target_dir/$filename" || exit 1
prune_local_backups "$target_dir" "$retention" "$pattern"
if ! remote_upload_backup "$target_dir/$filename" "$kind" "$DOMAIN"; then
    warn "Local backup completed; remote upload failed for $DOMAIN"
    exit 1
fi
ok "Scheduled $kind backup completed for $DOMAIN: $target_dir/$filename"
shieldpress_notify_event backup_success "Scheduled backup completed" "$DOMAIN ($kind): $filename"
